+def runtime_estimate(counts):
+    non_uid = counts['non_uid_trials']; uid = counts['uid_trials']; writer = counts['writer_trials']
+    seconds = non_uid * SEC_PER_TRIAL_NON_UID + uid * SEC_PER_TRIAL_UID + writer * WRITER_OVERHEAD_S
+    return {'seconds': round(seconds, 1), 'hours': round(seconds / 3600.0, 3),
+            'model': {'sec_per_trial_non_uid': SEC_PER_TRIAL_NON_UID,
+                      'sec_per_trial_uid': SEC_PER_TRIAL_UID,
+                      'writer_overhead_s': WRITER_OVERHEAD_S}}
