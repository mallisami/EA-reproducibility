+        reads.append(rec)
+        return rec['value']
+
+    def read_pod():
+        rec, obj = _record_read(responder, None, kind='pod')
+        reads.append(rec)
+        return rec['value']
+
+    # helper to arm the writer for a negative delta immediately before a read.
+    def arm_before_final(final_read_callable):
+        if writer is not None and writer.negative:
