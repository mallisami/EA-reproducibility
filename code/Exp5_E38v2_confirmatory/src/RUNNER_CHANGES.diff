+# --------------------------------------------------------------------------- #
+# LOCK verification (safety rail 7)
+# --------------------------------------------------------------------------- #
+def verify_lock(lock_path):
+    lock = json.loads(Path(lock_path).read_text())
+    hashes = lock.get('file_sha256', {})
+    mismatches = []
+    for rel, expected in hashes.items():
+        p = HERE / rel
+        if not p.is_file():
+            mismatches.append(f'{rel}: missing')
+        elif sha256_file(p) != expected:
+            mismatches.append(f'{rel}: sha256 mismatch')
+    if mismatches:
+        raise APIError('LOCK hash mismatch: ' + '; '.join(mismatches))
+    return lock
