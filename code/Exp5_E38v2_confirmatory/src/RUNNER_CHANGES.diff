+                self.conn.request(method, path, body=payload, headers=headers)
+                resp = self.conn.getresponse()
+                raw = resp.read()
+                status = resp.status
+                rheaders = CIHeaders(resp.getheaders())
+                obj = json.loads(raw) if raw else None
