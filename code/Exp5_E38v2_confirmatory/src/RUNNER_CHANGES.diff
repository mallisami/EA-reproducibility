+            return
+        elif method == 'POST' and path == f'{ns_root}/pods':
+            md = (body or {}).get('metadata', {})
+            if md.get('name') == POD_NAME and md.get('labels', {}).get('e38v2-managed') == 'true':
+                return
+        elif method == 'POST' and path == f'{ns_root}/configmaps':
+            md = (body or {}).get('metadata', {})
+            if md.get('name') in set(ALL_CMS) and md.get('labels', {}).get('e38v2-managed') == 'true':
