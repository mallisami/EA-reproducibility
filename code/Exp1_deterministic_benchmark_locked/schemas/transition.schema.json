{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transition.schema.json",
  "title": "FlashIR State Transition",
  "type": "object",
  "required": [
    "transition_id",
    "title",
    "actor",
    "capability_tier",
    "duration_s",
    "cost_ops",
    "effects",
    "adversarially_induced",
    "causal_parent_ids"
  ],
  "properties": {
    "transition_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "actor": {
      "enum": [
        "attacker",
        "environment",
        "benign_responder"
      ]
    },
    "capability_tier": {
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3",
        "NONE"
      ]
    },
    "duration_s": {
      "type": "number",
      "minimum": 0
    },
    "cost_ops": {
      "type": "integer",
      "minimum": 0
    },
    "preconditions": {
      "type": [
        "object",
        "boolean"
      ]
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "op",
          "path",
          "value"
        ],
        "properties": {
          "op": {
            "const": "set"
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "value": {}
        },
        "additionalProperties": false
      }
    },
    "notes": {
      "type": "string"
    },
    "adversarially_induced": {
      "type": "boolean"
    },
    "causal_parent_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}